graph LR
  n0["flotillas/alpha — Admissible"]
  n1["flotillas/beta — Pending"]
  n2{{"waves/gate — Settled"}}
  n0 --> n1
  n1 --> n2
  n0 -. AncestorPending .-> n1
  style n0 stroke:#b58900,stroke-width:1px
  style n1 stroke:#b58900,stroke-width:1px
  style n2 stroke:#2e7d32,stroke-width:1px
  linkStyle 2 stroke:#d1242f,stroke-width:2px,stroke-dasharray:2 3
