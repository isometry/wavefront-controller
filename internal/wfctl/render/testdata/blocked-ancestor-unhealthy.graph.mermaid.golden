graph LR
  n0["flotillas/leaf — Pending"]
  n1["flotillas/mid — Pending"]
  n2["flotillas/root — Unhealthy"]
  n1 --> n0
  n2 --> n1
  n1 -. AncestorPending .-> n0
  n2 -. AncestorUnhealthy .-> n1
  style n0 stroke:#b58900,stroke-width:1px
  style n1 stroke:#b58900,stroke-width:1px
  style n2 stroke:#d1242f,stroke-width:1px
  linkStyle 2 stroke:#d1242f,stroke-width:2px,stroke-dasharray:2 3
  linkStyle 3 stroke:#d1242f,stroke-width:2px,stroke-dasharray:2 3
